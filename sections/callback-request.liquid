{% assign section_id = section.id | replace: '-', '_' %}

<style>
  .callback-container {
    padding: {% if section.settings.padding_top %}{{ section.settings.padding_top | default: 80 }}px{% else %}80px{% endif %} 
             {% if section.settings.padding_bottom %}{{ section.settings.padding_bottom | default: 80 }}px{% else %}80px{% endif %};
    background: {% if section.settings.background_color %}{{ section.settings.background_color }}{% else %}linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%){% endif %};
    text-align: center;
  }

  .callback-inner {
    max-width: 600px;
    margin: 0 auto;
  }

  .callback-title {
    font-size: 32px;
    font-weight: 700;
    color: #111827;
    margin-bottom: 15px;
    line-height: 1.3;
  }

  .callback-description {
    font-size: 16px;
    color: #6b7280;
    margin-bottom: 35px;
    line-height: 1.6;
  }

  .callback-btn {
    background: linear-gradient(135deg, #003566 0%, #090909 100%);
    color: white;
    padding: 16px 40px;
    border: none;
    border-radius: 8px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(0, 53, 102, 0.2);
  }

  .callback-btn:hover {
    background: linear-gradient(135deg, #002244 0%, #003566 100%);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 53, 102, 0.3);
  }

  /* Modal Styles */
  .callback-modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.7);
    z-index: 99999;
    overflow-y: auto;
    backdrop-filter: blur(4px);
  }

  .callback-modal.active {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .callback-modal-content {
    background: white;
    width: 100%;
    max-width: 500px;
    border-radius: 16px;
    padding: 40px;
    position: relative;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
    margin: 20px;
    animation: slideUp 0.3s ease-out;
  }

  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .callback-modal-close {
    position: absolute;
    top: 20px;
    right: 20px;
    background: #f3f4f6;
    border: none;
    border-radius: 50%;
    width: 36px;
    height: 36px;
    font-size: 18px;
    cursor: pointer;
    color: #4b5563;
    font-weight: bold;
    transition: background 0.2s;
  }

  .callback-modal-close:hover {
    background: #e5e7eb;
  }

  .callback-modal-title {
    font-size: 22px;
    font-weight: 700;
    color: #111827;
    margin-bottom: 8px;
    text-align: left;
  }

  .callback-modal-subtitle {
    font-size: 14px;
    color: #6b7280;
    margin-bottom: 25px;
    text-align: left;
  }

  .callback-form-group {
    margin-bottom: 16px;
  }

  .callback-form-group-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 16px;
  }

  .callback-label {
    font-size: 13px;
    font-weight: 600;
    color: #374151;
    margin-bottom: 6px;
    display: block;
    text-align: left;
  }

  .callback-input {
    width: 100%;
    padding: 12px 14px;
    border: 2px solid #e5e7eb;
    border-radius: 8px;
    font-size: 14px;
    font-family: inherit;
    box-sizing: border-box;
    transition: border-color 0.2s, box-shadow 0.2s;
    outline: none;
  }

  .callback-input:focus {
    border-color: #003566;
    box-shadow: 0 0 0 3px rgba(0, 53, 102, 0.1);
  }

  .callback-textarea {
    resize: vertical;
    min-height: 100px;
  }

  .callback-checkbox {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin-top: 20px;
    font-size: 12px;
    color: #6b7280;
    line-height: 1.6;
  }

  .callback-checkbox input {
    margin-top: 3px;
    cursor: pointer;
    width: 16px;
    height: 16px;
  }

  .callback-form-actions {
    display: flex;
    gap: 12px;
    margin-top: 25px;
  }

  .callback-submit-btn {
    flex: 1;
    background: linear-gradient(135deg, #003566 0%, #00509e 100%);
    color: white;
    padding: 12px 24px;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    font-weight: 600;
    font-size: 14px;
    transition: all 0.2s;
  }

  .callback-submit-btn:hover {
    background: linear-gradient(135deg, #002244 0%, #003566 100%);
  }

  .callback-submit-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .callback-cancel-btn {
    flex: 1;
    background: white;
    color: #003566;
    border: 2px solid #003566;
    padding: 10px 24px;
    border-radius: 8px;
    cursor: pointer;
    font-weight: 600;
    font-size: 14px;
    transition: all 0.2s;
  }

  .callback-cancel-btn:hover {
    background: #f0f4ff;
  }

  .callback-success {
    display: none;
    background: #ecfdf5;
    border: 1px solid #10b981;
    padding: 30px;
    border-radius: 12px;
    text-align: center;
    color: #065f46;
    animation: fadeIn 0.3s ease;
  }

  .callback-success h3 {
    margin-top: 0;
    color: #065f46;
    font-size: 20px;
  }

  .callback-success p {
    margin-bottom: 0;
    font-size: 14px;
    line-height: 1.6;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @media (max-width: 640px) {
    .callback-container {
      padding: 40px 20px;
    }

    .callback-title {
      font-size: 24px;
    }

    .callback-modal-content {
      padding: 30px 20px;
      max-width: 100%;
    }

    .callback-form-group-row {
      grid-template-columns: 1fr;
    }
  }
</style>

<div class="callback-container">
  <div class="callback-inner">
    <h2 class="callback-title">{{ section.settings.title }}</h2>
    <p class="callback-description">{{ section.settings.description }}</p>
    <button class="callback-btn" onclick="openCallbackModal()">{{ section.settings.button_text }}</button>
  </div>
</div>

<!-- Callback Modal -->
<div id="CallbackModal" class="callback-modal" onclick="if(event.target.id === 'CallbackModal') closeCallbackModal()">
  <div class="callback-modal-content">
    <button type="button" class="callback-modal-close" onclick="closeCallbackModal()">✕</button>
    
    <h3 class="callback-modal-title">Request a Callback</h3>
    <p class="callback-modal-subtitle">Fill in your details and we'll get back to you soon</p>

    <div id="CallbackFormContainer">
      {% form 'customer', id: 'CallbackForm', class: 'callback-form' %}
        <input type="hidden" name="contact[tags]" value="Callback Request">
        <input type="hidden" name="contact[note][Request Type]" value="Callback Request">

        <div class="callback-form-group">
          <label class="callback-label">First Name *</label>
          <input 
            type="text" 
            name="contact[first_name]" 
            class="callback-input" 
            placeholder="John"
            required
          >
        </div>

        <div class="callback-form-group">
          <label class="callback-label">Last Name *</label>
          <input 
            type="text" 
            name="contact[note][Last Name]" 
            class="callback-input" 
            placeholder="Doe"
            required
          >
        </div>

        <div class="callback-form-group">
          <label class="callback-label">Email Address *</label>
          <input 
            type="email" 
            name="contact[email]" 
            class="callback-input" 
            placeholder="john@example.com"
            required
          >
        </div>

        <div class="callback-form-group">
          <label class="callback-label">Phone Number *</label>
          <input 
            type="tel" 
            name="contact[note][Phone Number]" 
            class="callback-input" 
            placeholder="+1 (555) 123-4567"
            required
          >
        </div>

        <div class="callback-form-group">
          <label class="callback-label">Company Name *</label>
          <input 
            type="text" 
            name="contact[note][Company Name]" 
            class="callback-input" 
            placeholder="Your Company"
            required
          >
        </div>

        <div class="callback-form-group">
          <label class="callback-label">Message (Optional)</label>
          <textarea 
            name="contact[note][Customer Message]" 
            class="callback-input callback-textarea" 
            placeholder="Tell us how we can help..."
          ></textarea>
        </div>

        <div class="callback-checkbox">
          <input type="checkbox" id="callback-agree" required>
          <label for="callback-agree" style="margin: 0; cursor: pointer;">
            By submitting, you agree to our Terms and Conditions and Privacy Policy
          </label>
        </div>

        <div class="callback-form-actions">
          <button type="button" class="callback-cancel-btn" onclick="closeCallbackModal()">Cancel</button>
          <button type="submit" class="callback-submit-btn">Send Request</button>
        </div>
      {% endform %}
    </div>

    <div id="CallbackSuccess" class="callback-success">
      <h3>✓ Request Sent!</h3>
      <p>Thank you! We'll be in touch within 24 hours.</p>
    </div>
  </div>
</div>

<script>
  function openCallbackModal() {
    document.getElementById('CallbackModal').classList.add('active');
    document.body.style.overflow = 'hidden';
  }

  function closeCallbackModal() {
    document.getElementById('CallbackModal').classList.remove('active');
    document.body.style.overflow = 'auto';
    // Reset form
    document.getElementById('CallbackForm').reset();
    document.getElementById('CallbackFormContainer').style.display = 'block';
    document.getElementById('CallbackSuccess').style.display = 'none';
  }

  document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('CallbackForm');
    
    if (form) {
      form.addEventListener('submit', function(e) {
        e.preventDefault();
        
        const submitBtn = form.querySelector('button[type="submit"]');
        const originalText = submitBtn.innerHTML;
        
        submitBtn.disabled = true;
        submitBtn.innerHTML = 'Sending... ⏳';

        const formData = new FormData(form);
        
        fetch('/contact', {
          method: 'POST',
          body: new URLSearchParams(formData)
        })
        .then(response => {
          submitBtn.disabled = false;
          submitBtn.innerHTML = originalText;
          
          // Show success message
          document.getElementById('CallbackFormContainer').style.display = 'none';
          document.getElementById('CallbackSuccess').style.display = 'block';

          // Auto close after 3 seconds
          setTimeout(() => {
            closeCallbackModal();
          }, 3000);
        })
        .catch(error => {
          submitBtn.disabled = false;
          submitBtn.innerHTML = originalText;
          alert('Error submitting form. Please try again.');
          console.error('Error:', error);
        });
      });
    }
  });

  // Close modal on Escape key
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && document.getElementById('CallbackModal').classList.contains('active')) {
      closeCallbackModal();
    }
  });
</script>

{% schema %}
{
  "name": "Callback Request",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Ready To Get Started?"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Talk to our team today and learn how we can help your business."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Request a Callback"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#f8f9fa"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Callback Request"
    }
  ]
}
{% endschema %}
